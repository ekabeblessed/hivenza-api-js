{
  "name": "@hivenza/api",
  "version": "0.3.1",
  "description": "The typed JavaScript client for Hivenza's developer API: publish posts, answer the inbox, read analytics and handle webhooks from your own code.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "require": {
        "types": "./dist/webhooks.d.cts",
        "default": "./dist/webhooks.cjs"
      }
    },
    "./connect": {
      "import": {
        "types": "./dist/connect.d.ts",
        "default": "./dist/connect.js"
      },
      "require": {
        "types": "./dist/connect.d.cts",
        "default": "./dist/connect.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "hivenza",
    "social media",
    "api",
    "inbox",
    "webhooks",
    "sdk",
    "typescript"
  ],
  "homepage": "https://hivenza.com/developers",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "publint --strict",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run verify",
    "release": "npm run check && npm publish --access public"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ekabeblessed/hivenza-api-js.git"
  },
  "bugs": {
    "url": "https://github.com/ekabeblessed/hivenza-api-js/issues"
  }
}
